# Variables para docker compose. Copiar como .env y completar.

# OBLIGATORIA: clave para firmar los JWT (mínimo 16 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Base de datos
POSTGRES_USER=mamba
POSTGRES_PASSWORD=
POSTGRES_DB=semillero_mamba
# Puerto del host para Postgres (cámbialo si ya tienes uno local en 5432)
DB_HOST_PORT=5432

# false = no crear tablas ni usuarios de demostración (usar en producción)
SEED_ENABLED=true

# Orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:3001

# URLs vistas desde el navegador (se incrustan al construir el frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHAT_URL=http://localhost:8001
