# Variables de entorno - Frontend MAMBA
# Copiar este archivo como .env.local y completar los valores

# URL del backend NestJS (API principal — Docker mamba_api o npm run start:dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL del microservicio del chatbot (mamba-ai-service / FastAPI)
NEXT_PUBLIC_CHAT_URL=http://localhost:8001
